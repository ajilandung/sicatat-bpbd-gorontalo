# Contoh berkas .env untuk peladen produksi (Hostinger).
#
# Cara pakai: salin isi berkas ini menjadi `.env` di akar proyek pada peladen,
# lalu isi bagian yang bertanda GANTI. Berkas `.env` sendiri tidak pernah ikut
# ke repositori maupun ke berkas zip — memang begitu seharusnya, karena berisi
# kata sandi basis data dan kunci enkripsi aplikasi.

APP_NAME=Sicatat
APP_ENV=production
# GANTI: salin nilai APP_KEY dari .env lokal, atau buat baru di peladen dengan
# `php artisan key:generate`. Membuat baru tidak merusak kata sandi pengguna,
# hanya memutus sesi login yang sedang berjalan.
APP_KEY=
# APP_DEBUG wajib false di produksi. Bila true, setiap galat akan menampilkan
# kode sumber beserta kredensial basis data kepada siapa pun yang membuka situs.
APP_DEBUG=false
# GANTI: alamat lengkap situs, memakai https bila sertifikat SSL sudah aktif.
# Nilai ini dipakai untuk menyusun tautan aset (CSS/JS) dan tautan foto.
APP_URL=https://domain-anda.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Di produksi cukup catat peringatan ke atas, supaya storage/logs tidak
# membengkak oleh catatan debug harian.
LOG_LEVEL=warning

# GANTI: seluruh nilai di bawah diambil dari hPanel Hostinger,
# menu Databases > Management. Nama basis data dan nama pengguna selalu
# berawalan nomor akun, misalnya u123456789_sicatat.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cookie sesi hanya dikirim lewat koneksi terenkripsi. Aktifkan (true) setelah
# SSL menyala; biarkan false bila situs untuk sementara masih diakses via http,
# karena bila true tanpa https pengguna tidak akan pernah bisa login.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
# GANTI: domain situs tanpa protokol, misalnya sicatat-bpbd.com.
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Sicatat tidak mengirim surel sama sekali — pengaturan ulang kata sandi
# dikerjakan administrator langsung dari halaman kelola pengguna. Setelan surel
# dibiarkan menulis ke berkas log supaya tidak ada yang perlu dikonfigurasi.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
